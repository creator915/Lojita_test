cabal-version: 3.0
name: cctt-core
version: 0.1.0.0
license: MIT
license-file: LICENSE
build-type: Simple

library
  exposed-modules:
      Common
      Core
      CoreTypes
      Quotation
      Cubical
  other-modules:
      Statistics
      Data.LvlMap
      Cubical.Interval
      Cubical.Substitution
      Cubical.Cofibration
  hs-source-dirs: src
  build-depends:
      base >=4.7 && <5,
      bytestring,
      containers,
      flatparse,
      ghc-prim,
      microlens,
      microlens-th,
      primdata,
      template-haskell,
      time
  default-language: GHC2021
  default-extensions:
      AllowAmbiguousTypes
      BangPatterns
      BlockArguments
      CPP
      ConstraintKinds
      DataKinds
      DerivingVia
      EmptyDataDeriving
      ExplicitNamespaces
      FlexibleContexts
      FlexibleInstances
      FunctionalDependencies
      GADTs
      ImplicitParams
      InstanceSigs
      KindSignatures
      LambdaCase
      MagicHash
      MultiParamTypeClasses
      OverloadedStrings
      PackageImports
      PatternSynonyms
      PolyKinds
      QualifiedDo
      RankNTypes
      ScopedTypeVariables
      StandaloneDeriving
      Strict
      TemplateHaskell
      TypeApplications
      TypeFamilies
      TypeFamilyDependencies
      UnboxedSums
      UnboxedTuples
      UndecidableInstances
      UnicodeSyntax
      ViewPatterns
  ghc-options:
      -O2
      -fdicts-strict
      -fworker-wrapper-cbv
      -Wall
      -Wno-name-shadowing
      -Wno-missing-signatures
      -Wno-unused-do-bind
      -Wno-unused-matches
      -Wno-missing-pattern-synonym-signatures
