#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: cubical-agda-run \
  --source FILE --entry NAME \
  --boundary none|cross-process|in-process \
  --output-dir DIR \
  [--native-classification ordinary|erased-cubical] \
  [--packet-expression EXPR --packet-consumer EXPR] \
  [--packet-consumer-source FILE] \
  [--runtime-expression EXPR] \
  [--include DIR ...] [--agda-arg ARG ...]

Run one real CubicalChez binding-time analysis, dispatch exactly one production
lane, and retain only that lane's successful publications.
EOF
}

fail() { printf 'CCZ-PROGRAM-REJECT: %s\n' "$*" >&2; exit 65; }
need_value() { [[ $# -ge 2 ]] || fail "missing value for $1"; }

source_file=
entry=
boundary=
output_dir=
native_classification=
packet_expression=
packet_consumer=
packet_consumer_source=
runtime_expression=
declare -a include_dirs=('')
declare -a agda_args=('')

while [[ $# -gt 0 ]]; do
  case $1 in
    --source) need_value "$@"; source_file=$2; shift 2 ;;
    --entry) need_value "$@"; entry=$2; shift 2 ;;
    --boundary) need_value "$@"; boundary=$2; shift 2 ;;
    --output-dir) need_value "$@"; output_dir=$2; shift 2 ;;
    --native-classification) need_value "$@"; native_classification=$2; shift 2 ;;
    --packet-expression) need_value "$@"; packet_expression=$2; shift 2 ;;
    --packet-consumer) need_value "$@"; packet_consumer=$2; shift 2 ;;
    --packet-consumer-source) need_value "$@"; packet_consumer_source=$2; shift 2 ;;
    --runtime-expression) need_value "$@"; runtime_expression=$2; shift 2 ;;
    --include) need_value "$@"; include_dirs+=("$2"); shift 2 ;;
    --agda-arg) need_value "$@"; agda_args+=("$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1" ;;
  esac
done

for required in source_file entry boundary output_dir; do
  [[ -n ${!required} ]] || fail "missing required option for $required"
done
[[ -f $source_file && $source_file == *.agda ]] ||
  fail "source is not an Agda file: $source_file"
[[ -d $output_dir ]] || fail "output directory does not exist: $output_dir"
case $boundary in none|cross-process|in-process) ;; *) fail "invalid boundary: $boundary" ;; esac
case $boundary in
  none)
    [[ $native_classification == ordinary || $native_classification == erased-cubical ]] ||
      fail "native lane requires a valid classification"
    ;;
  cross-process)
    [[ -n $packet_expression && $packet_expression == "$entry" ]] ||
      fail "packet expression must equal the checked analysis entry"
    [[ -n $packet_consumer ]] || fail "packet lane requires a consumer"
    ;;
  in-process)
    [[ -n $runtime_expression && $runtime_expression == "$entry" ]] ||
      fail "runtime expression must equal the checked analysis entry"
    ;;
esac

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
dispatcher=$repo_root/bin/cubical-agda-dispatch
lane_exec=$repo_root/bin/cubical-agda-lane-exec
analyzer=${CUBICAL_ANALYZER:?set CUBICAL_ANALYZER}
analyzer_agda_data=${CUBICAL_ANALYZER_AGDA_DATA:?set CUBICAL_ANALYZER_AGDA_DATA}
for executable in "$dispatcher" "$lane_exec" "$analyzer"; do
  [[ -x $executable ]] || fail "required executable is missing: $executable"
done

source_dir=$(CDPATH= cd -- "$(dirname -- "$source_file")" && pwd -P)
source_file=$source_dir/$(basename -- "$source_file")
output_dir=$(CDPATH= cd -- "$output_dir" && pwd -P)
packet_consumer_source=${packet_consumer_source:-$source_file}

sha256_file() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    shasum -a 256 "$1" | awk '{ print $1 }'
  fi
}

analysis_source_sha256=$(sha256_file "$source_file")

published_artifacts='
analysis.txt
dispatch.provenance.tsv
native-program
native-program.provenance.tsv
native-program.malonzo.sha256
native-program.malonzo.tar
native-program.binary-audit.txt
native.observation
native.provenance.tsv
term.packet
packet.observation
packet.provenance.tsv
runtime-nbe.packet
runtime-nbe.observation
runtime-nbe.provenance.tsv
'
clear_publications() {
  while IFS= read -r name; do
    [[ -n $name ]] && rm -f -- "$output_dir/$name"
  done <<< "$published_artifacts"
  return 0
}

clear_publications
stage=$(mktemp -d "$output_dir/.program-analysis.XXXXXX")
success=no
child_pid=
cleanup() {
  rm -rf -- "$stage"
  [[ $success == yes ]] || clear_publications
}
interrupt_child() {
  local signal=$1 status=$2
  if [[ -n $child_pid ]]; then
    kill -s "$signal" "$child_pid" 2>/dev/null || true
    wait "$child_pid" 2>/dev/null || true
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'interrupt_child HUP 129' HUP
trap 'interrupt_child INT 130' INT
trap 'interrupt_child TERM 143' TERM

declare -a analyzer_command=(
  "$analyzer" --cubical-chez --cubical-chez-engine=agda-baseline
  --cubical-chez-residual=manifest "--cubical-chez-output=$stage"
  "--cubical-chez-entry=$entry" -i "$source_dir" --no-write-interfaces
)
for include_dir in "${include_dirs[@]:1}"; do
  [[ -d $include_dir ]] || fail "include directory does not exist: $include_dir"
  analyzer_command+=(-i "$include_dir")
done
analyzer_command+=("${agda_args[@]:1}" "$source_file")

set +e
Agda_datadir="$analyzer_agda_data" "${analyzer_command[@]}" \
  > "$stage/analyzer.stdout" 2> "$stage/analyzer.stderr" &
child_pid=$!
wait "$child_pid"
analyzer_status=$?
child_pid=
set -e
[[ -s $stage/staging.txt ]] || {
  cat "$stage/analyzer.stdout"; cat "$stage/analyzer.stderr" >&2
  fail "analysis produced no checked staging manifest"
}
binding_time=$(sed -n 's/^binding-time: //p' "$stage/staging.txt")
[[ -n $binding_time && $(grep -c '^binding-time: ' "$stage/staging.txt") -eq 1 ]] ||
  fail "analysis has no unique binding-time"
case $binding_time in
  static) [[ $analyzer_status -eq 0 ]] || fail "static analysis failed with status $analyzer_status" ;;
  dynamic|mixed|unsupported) [[ $analyzer_status -ne 0 ]] || fail "$binding_time analysis unexpectedly reported static success" ;;
  *) fail "unknown binding-time class: $binding_time" ;;
esac

post_analysis_source_sha256=$(sha256_file "$source_file")
[[ $post_analysis_source_sha256 == "$analysis_source_sha256" ]] ||
  fail "source changed while binding-time analysis was running"
if grep -q '^source-sha256: ' "$stage/staging.txt"; then
  fail "analysis unexpectedly supplied its own source-sha256"
fi
printf 'source-sha256: %s\n' "$analysis_source_sha256" >> "$stage/staging.txt"

cp -- "$stage/staging.txt" "$output_dir/analysis.txt"
declare -a dispatch_command=(
  "$dispatcher" --analysis "$output_dir/analysis.txt" --source "$source_file"
  --boundary "$boundary" --provenance "$output_dir/dispatch.provenance.tsv"
  --native-exec "$lane_exec" --native-arg --output-dir --native-arg "$output_dir"
  --native-arg --classification --native-arg "$native_classification"
  --packet-exec "$lane_exec" --packet-arg --output-dir --packet-arg "$output_dir"
  --packet-arg --expression --packet-arg "$packet_expression"
  --packet-arg --consumer --packet-arg "$packet_consumer"
  --packet-arg --consumer-source --packet-arg "$packet_consumer_source"
  --runtime-nbe-exec "$lane_exec" --runtime-nbe-arg --output-dir
  --runtime-nbe-arg "$output_dir" --runtime-nbe-arg --expression
  --runtime-nbe-arg "$runtime_expression"
)
for include_dir in "${include_dirs[@]:1}"; do
  dispatch_command+=(--native-arg --include --native-arg "$include_dir")
done
for argument in "${agda_args[@]:1}"; do
  dispatch_command+=(--packet-arg --agda-arg --packet-arg "$argument")
  dispatch_command+=(--runtime-nbe-arg --agda-arg --runtime-nbe-arg "$argument")
done

set +e
"${dispatch_command[@]}" &
child_pid=$!
wait "$child_pid"
dispatch_status=$?
child_pid=
set -e
[[ $dispatch_status -eq 0 ]] || exit "$dispatch_status"

case $boundary in
  none) [[ -s $output_dir/native.provenance.tsv ]] || fail "native adapter published no provenance" ;;
  cross-process) [[ -s $output_dir/packet.provenance.tsv ]] || fail "packet adapter published no provenance" ;;
  in-process) [[ -s $output_dir/runtime-nbe.provenance.tsv ]] || fail "runtime adapter published no provenance" ;;
esac

rm -rf -- "$stage"
stage=
success=yes
trap - EXIT HUP INT TERM
printf 'CubicalAgdaProgram PASS (%s, %s)\n' "$binding_time" "$boundary"
