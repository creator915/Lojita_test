cabal-version: 2.4
name: agda-cctt-runtime
version: 0.1.0.0
build-type: Simple
license: MIT

executable agda-cctt-runtime
  hs-source-dirs: src
  main-is: Main.hs
  other-modules: RuntimeNbe.Integrated
  build-depends:
      Agda == 2.8.0
    , agda-runtime-nbe-producer
    , base
    , bytestring
    , cctt-runtime-provider
    , directory
  default-language: Haskell2010
  ghc-options: -Wall -Werror -threaded
  if os(linux)
    ghc-options: -optl-Wl,--export-dynamic-symbol=runtime_nbe_cctt_eval_quote_v1
  if os(osx)
    ghc-options: -optl-Wl,-export_dynamic
