cabal-version: 2.4
name: cctt-runtime-provider
version: 0.1.0.0
build-type: Simple
license: MIT

flag embedded-policy
  description: Build the final test user binary with Agda-lowered IR embedded
  default: False
  manual: True

library
  hs-source-dirs: src
  exposed-modules:
      RuntimeNbe.CcttProvider
      RuntimeNbe.PacketDigest
  other-modules:
      Common
      Conversion
      Core
      CoreTypes
      Cubical
      Cubical.Cofibration
      Cubical.Interval
      Cubical.Substitution
      Data.LvlMap
      Elaboration
      ElabState
      Errors
      Lexer
      Parser
      Presyntax
      Pretty
      Quotation
      Statistics
  build-depends:
      base >= 4.7 && < 5
    , bytestring
    , containers
    , deepseq
    , directory
    , filepath
    , flatparse
    , ghc-prim
    , microlens
    , microlens-th
    , primdata
    , split
    , strict-impl-params
    , template-haskell
    , time
  default-language: Haskell2010
  default-extensions:
      AllowAmbiguousTypes
      BangPatterns
      BlockArguments
      CPP
      ConstraintKinds
      DataKinds
      DerivingVia
      EmptyDataDeriving
      ExplicitNamespaces
      FlexibleContexts
      FlexibleInstances
      FunctionalDependencies
      GADTs
      ImplicitParams
      InstanceSigs
      KindSignatures
      LambdaCase
      MagicHash
      MultiParamTypeClasses
      OverloadedStrings
      PackageImports
      PatternSynonyms
      PolyKinds
      QualifiedDo
      RankNTypes
      ScopedTypeVariables
      StandaloneDeriving
      StandaloneKindSignatures
      Strict
      TemplateHaskell
      TypeApplications
      TypeFamilies
      TypeFamilyDependencies
      UnboxedSums
      UnboxedTuples
      UndecidableInstances
      UnicodeSyntax
      ViewPatterns
  ghc-options:
      -O2
      -fdicts-strict
      -fmax-worker-args=18
      -fspecialise-aggressively
      -fexpose-all-unfoldings
      -fworker-wrapper-cbv
      -Wall
      -Wno-name-shadowing
      -Wno-missing-signatures
      -Wno-unused-do-bind
      -Wno-unused-matches
      -Wno-missing-pattern-synonym-signatures
      -fmax-relevant-binds=3
      -fmax-valid-hole-fits=0

executable runtime-nbe-provider
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
      base
    , bytestring
    , cctt-runtime-provider
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror -threaded
  if os(linux)
    ghc-options:
      -optl-Wl,--undefined=runtime_nbe_cctt_eval_quote_v1
      -optl-Wl,--export-dynamic-symbol=runtime_nbe_cctt_eval_quote_v1
  if os(osx)
    ghc-options: -optl-Wl,-export_dynamic

executable runtime-policy-user
  if !flag(embedded-policy)
    buildable: False
  hs-source-dirs: policy-app
  main-is: Main.hs
  other-modules: RuntimeNbe.EmbeddedPolicy
  build-depends:
      base
    , bytestring
    , cctt-runtime-provider
    , template-haskell
  default-language: Haskell2010
  ghc-options: -O2 -Wall -Werror -threaded
  if os(linux)
    ghc-options:
      -optl-Wl,--undefined=runtime_nbe_cctt_eval_quote_v1
      -optl-Wl,--export-dynamic-symbol=runtime_nbe_cctt_eval_quote_v1
  if os(osx)
    ghc-options: -optl-Wl,-export_dynamic
